@model KioskManagement.Models.Kiosk

@{
    ViewBag.Title = "Thêm Kios";
}

<h2 class="text-center mb-4">THÊM KIOS MỚI</h2>

@using (Html.BeginForm("Create", "Kiosk", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.KioskName, "Tên Kios")
        @Html.TextBoxFor(m => m.KioskName,
                 new { @class = "form-control", placeholder = "Nhập tên kios" })
        @Html.ValidationMessageFor(m => m.KioskName,
                 "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.AreaId, "Khu vực")
        @Html.DropDownListFor(m => m.AreaId,
                 (SelectList)ViewBag.AreaId,
                 "-- Chọn khu vực --",
                 new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.AreaId,
                 "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.ProjectId, "Dự án")
        @Html.DropDownListFor(m => m.ProjectId,
                 (SelectList)ViewBag.ProjectId,
                 "-- Chọn dự án --",
                 new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.ProjectId,
                 "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.AreaSize, "Diện tích")
        @Html.TextBoxFor(m => m.AreaSize,
                 new { @class = "form-control", type = "number", step = "0.01", min = "0" })
        @Html.ValidationMessageFor(m => m.AreaSize,
                 "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.RentalPrice, "Giá thuê")
        @Html.TextBoxFor(m => m.RentalPrice,
                 new { @class = "form-control", type = "number", step = "0.01", min = "0" })
        @Html.ValidationMessageFor(m => m.RentalPrice,
                 "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Description, "Mô tả")
        @Html.TextAreaFor(m => m.Description,
                 new { @class = "form-control", rows = "4", placeholder = "Nhập mô tả (không bắt buộc)" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.ImageUrl, "Đường dẫn hình ảnh")
        @Html.TextBoxFor(m => m.ImageUrl,
                 new { @class = "form-control", placeholder = "Nhập URL hình ảnh (không bắt buộc)" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Status, "Trạng thái")
        @Html.DropDownListFor(m => m.Status,
                 (SelectList)ViewBag.StatusList,
                 "-- Chọn trạng thái --",
                 new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Status,
                 "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">
        Thêm mới
    </button>

    @Html.ActionLink("Quay lại", "Index",
            null, new { @class = "btn btn-secondary" })
}