@model KioskManagement.Models.Kiosk

@{
    ViewBag.Title = "Xóa Kios";
}

<h2 class="text-center mb-4 text-danger">XÁC NHẬN XÓA KIOS</h2>

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa kios này không?
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">
            <dt class="col-md-3">Mã Kios</dt>
            <dd class="col-md-9">@Model.KioskId</dd>

            <dt class="col-md-3">Tên Kios</dt>
            <dd class="col-md-9">@Model.KioskName</dd>

            <dt class="col-md-3">Khu vực</dt>
            <dd class="col-md-9">
                @(Model.Area != null ? Model.Area.AreaName : "")
            </dd>

            <dt class="col-md-3">Dự án</dt>
            <dd class="col-md-9">
                @(Model.Project != null ? Model.Project.ProjectName : "")
            </dd>

            <dt class="col-md-3">Diện tích</dt>
            <dd class="col-md-9">@Model.AreaSize</dd>

            <dt class="col-md-3">Giá thuê</dt>
            <dd class="col-md-9">@Model.RentalPrice.ToString("N0")</dd>

            <dt class="col-md-3">Trạng thái</dt>
            <dd class="col-md-9">@Model.Status</dd>
        </dl>

        @using (Html.BeginForm("Delete", "Kiosk",
            new { id = Model.KioskId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger">
                Xác nhận xóa
            </button>

            @Html.ActionLink("Hủy", "Index",
                     null, new { @class = "btn btn-secondary" })
        }

    </div>
</div>