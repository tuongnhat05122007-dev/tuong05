
@model KioskManagement.Models.Contract

@{
    ViewBag.Title = "Chi tiết hợp đồng";
}

<h2 class="mt-4">CHI TIẾT HỢP ĐỒNG</h2>
<hr />

<div class="card">
    <div class="card-header bg-dark text-white">
        Thông tin hợp đồng
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-md-3">Mã hợp đồng</dt>
            <dd class="col-md-9">@Model.ContractId</dd>

            <dt class="col-md-3">Khách hàng</dt>
            <dd class="col-md-9">@Model.Customer.FullName</dd>

            <dt class="col-md-3">Số điện thoại</dt>
            <dd class="col-md-9">@Model.Customer.Phone</dd>

            <dt class="col-md-3">Kios</dt>
            <dd class="col-md-9">@Model.Kiosk.KioskName</dd>

            <dt class="col-md-3">Ngày bắt đầu</dt>
            <dd class="col-md-9">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-md-3">Ngày kết thúc</dt>
            <dd class="col-md-9">@Model.EndDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-md-3">Giá thuê</dt>
            <dd class="col-md-9">@Model.RentalPrice.ToString("N0")</dd>

            <dt class="col-md-3">Tiền đặt cọc</dt>
            <dd class="col-md-9">@Model.Deposit.ToString("N0")</dd>

            <dt class="col-md-3">Trạng thái</dt>
            <dd class="col-md-9">
                @switch (Model.Status)
                {
                    case "Pending":
                        <span>Chờ xác nhận</span>
                        break;
                    case "Active":
                        <span>Đang hiệu lực</span>
                        break;
                    case "Completed":
                        <span>Đã hoàn thành</span>
                        break;
                    case "Cancelled":
                        <span>Đã hủy</span>
                        break;
                    default:
                        <span>@Model.Status</span>
                        break;
                }
            </dd>

            <dt class="col-md-3">Số lần thanh toán</dt>
            <dd class="col-md-9">@Model.Payments.Count</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @Html.ActionLink("Chỉnh sửa", "Edit",
            new { id = Model.ContractId },
            new { @class = "btn btn-warning" })

    @Html.ActionLink("Quay lại", "Index",
            null, new { @class = "btn btn-secondary" })
</div>
