
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Kiosk Management</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        /* =====================================
           THANH MENU CHINH
        ===================================== */
        .main-navbar {
            background: linear-gradient(90deg, #10243A, #173B5E);
            min-height: 75px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.2);
        }

        /* =====================================
           LOGO TQT VA TEN WEBSITE
        ===================================== */
        .navbar-brand-custom {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #FFFFFF !important;
            font-weight: bold;
            font-size: 19px;
            text-decoration: none !important;
            margin-right: 25px;
            flex-shrink: 0;
        }

            .navbar-brand-custom img {
                height: 55px;
                width: auto;
                object-fit: contain;
                filter: brightness(1.25) contrast(1.1);
            }

            .navbar-brand-custom:hover {
                color: #FFB13B !important;
            }

        /* =====================================
           KHU VUC CAC BIEU TUONG MENU
        ===================================== */
        .navbar-icons {
            display: flex;
            align-items: center;
            justify-content: space-evenly;
            width: 100%;
            gap: 8px;
        }

            /* O BIEU TUONG */
            .navbar-icons .icon-link {
                flex: 1;
                max-width: 58px;
                min-width: 44px;
                height: 46px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #F5F9FF;
                border-radius: 10px;
                text-decoration: none;
                transition: all 0.25s ease;
                position: relative;
            }

                /* KICH THUOC BIEU TUONG */
                .navbar-icons .icon-link svg {
                    width: 24px;
                    height: 24px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

                /* HIEU UNG KHI DI CHUOT */
                .navbar-icons .icon-link:hover {
                    background: #F59E0B;
                    color: #10243A;
                    transform: translateY(-3px);
                }

                /* HIEN TEN CHUC NANG KHI DI CHUOT */
                .navbar-icons .icon-link::after {
                    content: attr(data-title);
                    position: absolute;
                    top: 55px;
                    left: 50%;
                    transform: translateX(-50%) translateY(-5px);
                    background: #FFFFFF;
                    color: #173B5E;
                    padding: 8px 12px;
                    border-radius: 6px;
                    font-size: 12px;
                    font-weight: 600;
                    white-space: nowrap;
                    box-shadow: 0 3px 10px rgba(0,0,0,0.2);
                    opacity: 0;
                    visibility: hidden;
                    transition: all 0.2s ease;
                    z-index: 1000;
                    pointer-events: none;
                }

                .navbar-icons .icon-link:hover::after {
                    opacity: 1;
                    visibility: visible;
                    transform: translateX(-50%) translateY(0);
                }

            /* =====================================
           NUT YEU CAU BAO TRI
        ===================================== */
            .navbar-icons .maintenance-link {
                background: #E88916;
                color: #FFFFFF;
            }

                .navbar-icons .maintenance-link:hover {
                    background: #FFB13B;
                    color: #10243A;
                }

        /* =====================================
           NOI DUNG TRANG
        ===================================== */
        .body-content {
            padding-top: 20px;
            min-height: 75vh;
        }

        /* FOOTER */
        footer {
            margin-top: 25px;
            color: #666;
        }

        /* =====================================
           GIAO DIEN DIEN THOAI / TABLET
        ===================================== */
        @@media (max-width: 991px) {

            .navbar-icons {
                display: flex;
                flex-wrap: wrap;
                justify-content: flex-start;
                padding: 15px 0;
                gap: 10px;
            }

                .navbar-icons .icon-link {
                    flex: 0 0 auto;
                    max-width: none;
                    width: auto;
                    padding: 0 12px;
                }
                    /* AN TOOLTIP TREN DIEN THOAI */
                    .navbar-icons .icon-link::after {
                        display: none;
                    }
                    /* HIEN TEN CHUC NANG TREN DIEN THOAI */
                    .navbar-icons .icon-link::before {
                        content: attr(data-title);
                        font-size: 13px;
                        margin-left: 8px;
                    }
        }

        /* MAN HINH RAT NHO */
        @@media (max-width: 480px) {
            .navbar-brand-custom {
                font-size: 15px;
                gap: 7px;
                margin-right: 5px;
            }

                .navbar-brand-custom img {
                    height: 42px;
                }
        }
    </style>
</head>

<body>

    <!-- =====================================
         THANH DIEU HUONG
    ====================================== -->
    <nav class="navbar navbar-expand-lg navbar-dark main-navbar">

        <div class="container">

            <!-- LOGO TQT -->
            <a href="@Url.Action("Index", "Kiosk")"
               class="navbar-brand-custom">

                <img src="@Url.Content("~/Content/Images/logo-tqt.png")"
                     alt="TQT Logo" />

                <span>KIOSK MANAGEMENT</span>

            </a>

            <!-- NUT MENU TREN DIEN THOAI -->
            <button class="navbar-toggler"
                    type="button"
                    data-toggle="collapse"
                    data-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <div class="navbar-nav navbar-icons">

                    <!-- 1. TRANG CHU -->
                    <a href="@Url.Action("Index", "Home")"
                       class="icon-link"
                       data-title="Trang chủ"
                       title="Trang chủ"
                       aria-label="Trang chủ">

                        <svg viewBox="0 0 24 24">
                            <path d="M3 10.5L12 3l9 7.5" />
                            <path d="M5 9.5V21h14V9.5" />
                            <path d="M9 21v-7h6v7" />
                        </svg>

                    </a>

                    <!-- 2. QUAN LY KIOS -->
                    <a href="@Url.Action("Index", "Kiosk")"
                       class="icon-link"
                       data-title="Quản lý Kios"
                       title="Quản lý Kios"
                       aria-label="Quản lý Kios">

                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="4" width="18" height="13" rx="2" />
                            <path d="M8 21h8M12 17v4" />
                            <path d="M7 8h10M7 11h6" />
                        </svg>

                    </a>

                    <!-- 3. QUAN LY KHU VUC -->
                    <a href="@Url.Action("Index", "Area")"
                       class="icon-link"
                       data-title="Quản lý khu vực"
                       title="Quản lý khu vực"
                       aria-label="Quản lý khu vực">

                        <svg viewBox="0 0 24 24">
                            <path d="M3 7l6-3 6 3 6-3v13l-6 3-6-3-6 3z" />
                            <path d="M9 4v13M15 7v13" />
                        </svg>

                    </a>

                    <!-- 4. QUAN LY DU AN -->
                    <a href="@Url.Action("Index", "Project")"
                       class="icon-link"
                       data-title="Quản lý dự án"
                       title="Quản lý dự án"
                       aria-label="Quản lý dự án">

                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="7" width="18" height="14" rx="2" />
                            <path d="M8 7V4h8v3M3 12h18M10 12v2h4v-2" />
                        </svg>

                    </a>

                    <!-- 5. QUAN LY KHACH HANG -->
                    <a href="@Url.Action("Index", "Customer")"
                       class="icon-link"
                       data-title="Quản lý khách hàng"
                       title="Quản lý khách hàng"
                       aria-label="Quản lý khách hàng">

                        <svg viewBox="0 0 24 24">
                            <circle cx="9" cy="8" r="4" />
                            <path d="M2 21v-2a7 7 0 0 1 14 0v2z" />
                            <path d="M16 5a4 4 0 0 1 0 7M18 15a6 6 0 0 1 4 6" />
                        </svg>

                    </a>

                    <!-- 6. QUAN LY HOP DONG -->
                    <a href="@Url.Action("Index", "Contract")"
                       class="icon-link"
                       data-title="Quản lý hợp đồng"
                       title="Quản lý hợp đồng"
                       aria-label="Quản lý hợp đồng">

                        <svg viewBox="0 0 24 24">
                            <path d="M6 3h9l4 4v14H6z" />
                            <path d="M15 3v5h4M9 12h7M9 16h7" />
                        </svg>

                    </a>

                    <!-- 7. QUAN LY THANH TOAN -->
                    <a href="@Url.Action("Index", "Payment")"
                       class="icon-link"
                       data-title="Quản lý thanh toán"
                       title="Quản lý thanh toán"
                       aria-label="Quản lý thanh toán">

                        <svg viewBox="0 0 24 24">
                            <rect x="2" y="5" width="20" height="14" rx="2" />
                            <path d="M2 10h20M7 15h4" />
                        </svg>

                    </a>

                    <!-- 8. YEU CAU BAO TRI -->
                    <a href="@Url.Action("Index", "MaintenanceRequest")"
                       class="icon-link maintenance-link"
                       data-title="Yêu cầu bảo trì"
                       title="Yêu cầu bảo trì"
                       aria-label="Yêu cầu bảo trì">

                        <svg viewBox="0 0 24 24">
                            <path d="M14 6a5 5 0 0 0-6.5 6.5L3 17v4h4l4.5-4.5A5 5 0 0 0 18 10l-3 3-4-4z" />
                            <path d="M17 3l4 4" />
                        </svg>

                    </a>

                </div>

            </div>
        </div>
    </nav>

    <!-- =====================================
         NOI DUNG CAC TRANG
    ====================================== -->
    <div class="container body-content">

        @RenderBody()

        <hr />

        <!-- FOOTER -->
        <footer class="text-center">
            <p>
                Kiosk Management -
                Website quản lý Kios thương mại
            </p>
        </footer>

    </div>

    <!-- =====================================
         JAVASCRIPT
    ====================================== -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>
