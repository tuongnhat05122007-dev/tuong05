
@model KioskManagement.Models.Area

@{
    ViewBag.Title = "Thêm khu vực";
}

<h2 class="mt-4 mb-3">THÊM KHU VỰC MỚI</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <div class="form-group">
            @Html.LabelFor(
                     model => model.AreaName,
                     "Tên khu vực",
                     new { @class = "control-label" }
                 )

            @Html.TextBoxFor(
                     model => model.AreaName,
                     new { @class = "form-control", placeholder = "Nhập tên khu vực" }
                 )

            @Html.ValidationMessageFor(
                     model => model.AreaName,
                     "",
                     new { @class = "text-danger" }
                 )
        </div>

        <div class="form-group">
            @Html.LabelFor(
                     model => model.Location,
                     "Địa điểm",
                     new { @class = "control-label" }
                 )

            @Html.TextBoxFor(
                     model => model.Location,
                     new { @class = "form-control", placeholder = "Nhập địa điểm" }
                 )

            @Html.ValidationMessageFor(
                     model => model.Location,
                     "",
                     new { @class = "text-danger" }
                 )
        </div>

        <div class="form-group">
            @Html.LabelFor(
                     model => model.Description,
                     "Mô tả"
                 )

            @Html.TextAreaFor(
                     model => model.Description,
                     new
                     {
                         @class = "form-control",
                         rows = "4",
                         placeholder = "Nhập mô tả khu vực"
                     }
                 )
        </div>

        <div class="form-group">
            <label>
                @Html.CheckBoxFor(model => model.IsActive)
                Khu vực đang hoạt động
            </label>
        </div>

        <button type="submit" class="btn btn-primary">
            Thêm khu vực
        </button>

        @Html.ActionLink(
                 "Quay lại",
                 "Index",
                 null,
                 new { @class = "btn btn-secondary" }
             )

    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
