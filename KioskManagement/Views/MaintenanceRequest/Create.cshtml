

@model KioskManagement.Models.MaintenanceRequest

@{
    ViewBag.Title = "Thêm yêu cầu bảo trì";
}

<h2>THÊM YÊU CẦU BẢO TRÌ</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="form-group">
        <label>Kiosk</label>
        @Html.DropDownList(
            "KioskId",
            null,
            "-- Chọn kiosk --",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.KioskId,
            "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Khách hàng</label>
        @Html.DropDownList(
            "CustomerId",
            null,
            "-- Chọn khách hàng --",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.CustomerId,
            "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Ngày yêu cầu</label>
        @Html.TextBoxFor(
            m => m.RequestDate,
            "{0:yyyy-MM-ddTHH:mm}",
            new { @class = "form-control", type = "datetime-local" })
        @Html.ValidationMessageFor(m => m.RequestDate,
            "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Nội dung yêu cầu</label>
        @Html.TextAreaFor(
            m => m.Description,
            new { @class = "form-control", rows = 4 })
        @Html.ValidationMessageFor(m => m.Description,
            "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Trạng thái</label>
        @Html.DropDownListFor(
            m => m.Status,
            new SelectList(
                new[]
                {
                    new { Value = "Pending", Text = "Đang chờ" },
                    new { Value = "InProgress", Text = "Đang xử lý" },
                    new { Value = "Completed", Text = "Hoàn thành" },
                    new { Value = "Cancelled", Text = "Đã hủy" }
                },
                "Value",
                "Text",
                Model.Status),
            new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">
        Lưu yêu cầu
    </button>

    @Html.ActionLink(
        "Quay lại",
        "Index",
        null,
        new { @class = "btn btn-default" })
}
