

@model IEnumerable<KioskManagement.Models.MaintenanceRequest>

@{
    ViewBag.Title = "Quản lý yêu cầu bảo trì";
}

<h2>QUẢN LÝ YÊU CẦU BẢO TRÌ</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<p>
    @Html.ActionLink(
        "Thêm yêu cầu bảo trì",
        "Create",
        null,
        new { @class = "btn btn-primary" })
</p>

@using (Html.BeginForm("Index", "MaintenanceRequest", FormMethod.Get))
{
    <div class="row">
        <div class="col-md-5">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Tìm kiosk, khách hàng, nội dung..." />
        </div>

        <div class="col-md-3">
            @Html.DropDownList(
                "status",
                (SelectList)ViewBag.StatusList,
                "Tất cả trạng thái",
                new { @class = "form-control" })
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-success">
                Tìm kiếm
            </button>
        </div>
    </div>
}

<br />

<table class="table table-bordered table-striped ">
    <tr style="background-color: #343a40; color: white;">
        <th style="color: white;">Mã yêu cầu</th>
        <th style="color: white;">Kiosk</th>
        <th style="color: white;">Khách hàng</th>
        <th style="color: white;">Ngày yêu cầu</th>
        <th style="color: white;">Nội dung</th>
        <th style="color: white;">Trạng thái</th>
        <th style="color: white;">Chức năng</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.RequestId</td>
            <td>@item.Kiosk.KioskName</td>
            <td>@item.Customer.FullName</td>
            <td>@item.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Description</td>
            <td>@item.Status</td>
            <td>
            <td>
                @Html.ActionLink("Chi tiết", "Details",
                    new { id = item.RequestId },
                    new { @class = "btn btn-info btn-sm" })

                @Html.ActionLink("Sửa", "Edit",
                    new { id = item.RequestId },
                    new { @class = "btn btn-warning btn-sm" })

                @Html.ActionLink("Xóa", "Delete",
                    new { id = item.RequestId },
                    new { @class = "btn btn-danger btn-sm" })
            </td>
            </td>
        </tr>
    }
</table>
