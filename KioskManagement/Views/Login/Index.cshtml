

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .login-wrapper {
        max-width: 430px;
        margin: 55px auto;
        padding: 35px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.12);
    }

    .login-title {
        text-align: center;
        color: #2c3e50;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .login-description {
        text-align: center;
        color: #777;
        margin-bottom: 28px;
    }

    .login-wrapper .form-control {
        height: 43px;
        border-radius: 6px;
    }

    .login-button {
        width: 100%;
        height: 44px;
        background: #2980b9;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        margin-top: 10px;
    }

        .login-button:hover {
            background: #21618c;
        }
</style>

<div class="container">
    <div class="login-wrapper">

        <h2 class="login-title">ĐĂNG NHẬP</h2>

        <p class="login-description">
            Hệ thống quản lý Kiosk thương mại
        </p>

        @using (Html.BeginForm("Index", "Login", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input type="text"
                       name="username"
                       class="form-control"
                       placeholder="Nhập tên đăng nhập"
                       required />
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>
                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="Nhập mật khẩu"
                       required />
            </div>

            if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="login-button">
                ĐĂNG NHẬP
            </button>
        }

    </div>
</div>
