
@model KioskManagement.Models.User

@{
    ViewBag.Title = "Thêm tài khoản";
}

<div class="container-fluid">
    <h2 style="font-weight:bold; color:#2c3e50;">
        THÊM TÀI KHOẢN
    </h2>

    <div class="card" style="padding:25px; border-radius:10px;">

        @using (Html.BeginForm("Create", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(false, "",
                     new { @class = "text-danger" })

            <div class="form-group">
                <label>Tên đăng nhập</label>
                @Html.TextBoxFor(m => m.Username,
                         new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Username,
                         "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>
                @Html.PasswordFor(m => m.PasswordHash,
                         new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Họ và tên</label>
                @Html.TextBoxFor(m => m.FullName,
                         new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Email</label>
                @Html.TextBoxFor(m => m.Email,
                         new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                @Html.TextBoxFor(m => m.Phone,
                         new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Vai trò</label>
                @Html.DropDownListFor(m => m.Role,
                         new SelectList(new[]
                         {
                        new { Value = "Admin", Text = "Admin" },
                        new { Value = "Staff", Text = "Staff" }
                         }, "Value", "Text"),
                         "-- Chọn vai trò --",
                         new { @class = "form-control" })
            </div>

            <button type="submit" class="btn btn-success">
                <i class="glyphicon glyphicon-plus"></i>
                Thêm tài khoản
            </button>

            <a href="@Url.Action("Index", "User")"
               class="btn btn-default">
                Quay lại
            </a>
        }
    </div>
</div>
