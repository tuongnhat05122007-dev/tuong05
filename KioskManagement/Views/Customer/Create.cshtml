
@model KioskManagement.Models.Customer

@{
    ViewBag.Title = "Thêm khách hàng";
}

<h2 class="mt-4">THÊM KHÁCH HÀNG</h2>

<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <div class="form-group">
            @Html.LabelFor(m => m.FullName, "Họ và tên",
                     new { @class = "control-label" })

            @Html.TextBoxFor(m => m.FullName,
                     new { @class = "form-control", placeholder = "Nhập họ tên" })

            @Html.ValidationMessageFor(m => m.FullName, "",
                     new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Phone, "Số điện thoại")

            @Html.TextBoxFor(m => m.Phone,
                     new { @class = "form-control", placeholder = "Nhập số điện thoại" })

            @Html.ValidationMessageFor(m => m.Phone, "",
                     new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Email, "Email")

            @Html.TextBoxFor(m => m.Email,
                     new { @class = "form-control", placeholder = "Nhập email" })

            @Html.ValidationMessageFor(m => m.Email, "",
                     new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Address, "Địa chỉ")

            @Html.TextAreaFor(m => m.Address,
                     new
                     {
                         @class = "form-control",
                         rows = "3",
                         placeholder = "Nhập địa chỉ"
                     })

            @Html.ValidationMessageFor(m => m.Address, "",
                     new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-success">
            Lưu khách hàng
        </button>

        @Html.ActionLink("Quay lại", "Index",
                 null, new { @class = "btn btn-secondary" })
    </div>
}
