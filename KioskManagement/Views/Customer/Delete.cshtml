
@model KioskManagement.Models.Customer

@{
    ViewBag.Title = "Xóa khách hàng";
}

<h2 class="mt-4 text-danger">XÓA KHÁCH HÀNG</h2>

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa khách hàng này không?
</div>

<div class="card">
    <div class="card-body">
        <p><strong>Mã khách hàng:</strong> @Model.CustomerId</p>
        <p><strong>Họ tên:</strong> @Model.FullName</p>
        <p><strong>Số điện thoại:</strong> @Model.Phone</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Địa chỉ:</strong> @Model.Address</p>
    </div>
</div>

@using (Html.BeginForm("Delete", "Customer",
    new { id = Model.CustomerId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="mt-3">
        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>

        @Html.ActionLink("Hủy", "Index",
                 null, new { @class = "btn btn-secondary" })
    </div>
}
