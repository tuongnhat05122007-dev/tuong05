
@model IEnumerable<KioskManagement.Models.Payment>

@{
    ViewBag.Title = "Quản lý thanh toán";
}

<h2 class="mt-4 mb-3">QUẢN LÝ THANH TOÁN</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row mb-3">
    <div class="col-md-8">
        @using (Html.BeginForm("Index", "Payment", FormMethod.Get))
        {
            <div class="form-row">
                <div class="col-md-6 mb-2">
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Tìm theo tên khách hàng hoặc Kiosk..." />
                </div>

                <div class="col-md-4 mb-2">
                    @Html.DropDownList(
                             "status",
                             (SelectList)ViewBag.StatusList,
                             "Tất cả trạng thái",
                             new { @class = "form-control" })
                </div>

                <div class="col-md-2 mb-2">
                    <button type="submit" class="btn btn-primary">
                        Tìm kiếm
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4 text-right">
        @Html.ActionLink(
                 "+ Thêm thanh toán",
                 "Create",
                 "Payment",
                 null,
                 new { @class = "btn btn-success" })
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Mã thanh toán</th>
                <th>Mã hợp đồng</th>
                <th>Khách hàng</th>
                <th>Kiosk</th>
                <th>Ngày thanh toán</th>
                <th>Số tiền</th>
                <th>Phương thức</th>
                <th>Trạng thái</th>
                <th>Chức năng</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PaymentId</td>
                        <td>@item.ContractId</td>
                        <td>@item.Contract.Customer.FullName</td>
                        <td>@item.Contract.Kiosk.KioskName</td>

                        <td>
                            @item.PaymentDate.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td class="text-right">
                            <strong>@item.Amount.ToString("N0") đ</strong>
                        </td>

                        <td>
                            @switch (item.PaymentMethod)
                            {
                                case "Cash":
                                    <span>Tiền mặt</span>
                                    break;
                                case "BankTransfer":
                                    <span>Chuyển khoản</span>
                                    break;
                                case "Online":
                                    <span>Trực tuyến</span>
                                    break;
                                default:
                                    <span>@item.PaymentMethod</span>
                                    break;
                            }
                        </td>

                        <td>
                            @switch (item.Status)
                            {
                                case "Pending":
                                    <span class="label label-warning">
                                        Đang chờ
                                    </span>
                                    break;

                                case "Success":
                                    <span class="label label-success">
                                        Thành công
                                    </span>
                                    break;

                                case "Failed":
                                    <span class="label label-danger">
                                        Thất bại
                                    </span>
                                    break;

                                default:
                                    <span>@item.Status</span>
                                    break;
                            }
                        </td>

                        <td>
                            @Html.ActionLink(
                                     "Chi tiết", "Details",
                                     new { id = item.PaymentId },
                                     new { @class = "btn btn-info btn-sm" })

                            @Html.ActionLink(
                                     "Sửa", "Edit",
                                     new { id = item.PaymentId },
                                     new { @class = "btn btn-warning btn-sm" })

                            @Html.ActionLink(
                                     "Xóa", "Delete",
                                     new { id = item.PaymentId },
                                     new { @class = "btn btn-danger btn-sm" })
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">
                        Chưa có dữ liệu thanh toán.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
